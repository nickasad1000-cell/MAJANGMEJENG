---
import Mark from './Mark.astro';

const NAV = [
  { href: '/cerita', label: 'Cerita' },
  { href: '/jasa', label: 'Jasa' },
  { href: '/hasil-kerja', label: 'Hasil Kerja' },
  { href: '/toko', label: 'Toko' },
  { href: '/tentang-kami', label: 'Tentang' },
  { href: '/titipkan-cerita', label: 'Titip Cerita' },
];

const current = Astro.url.pathname;

// Edition info — latest story count + date (build-time, SSG)
let editionNo = 11;
let editionDate = '11 Agustus 2026';
try {
  const res = await fetch('https://ymkrbeuwvruhmprqjmuj.supabase.co/rest/v1/stories?select=published_at&order=published_at.desc', {
    headers: { apikey: 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inlta3JiZXV3dnJ1aG1wcnFqbXVqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcwMjg0NzUsImV4cCI6MjEwMjYwNDQ3NX0.Hs3PaEvF6Fxie-GvhtVYH9Lj9SwItaO4eMby9a0a9FA' },
  });
  if (res.ok) {
    const rows = await res.json();
    if (Array.isArray(rows) && rows.length > 0) {
      editionNo = rows.length;
      const d = new Date(rows[0].published_at);
      editionDate = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
    }
  }
} catch {}
function isActive(href: string): boolean {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---

<header class="sticky top-0 z-40 border-b border-foreground/15 bg-background/90 backdrop-blur-sm">
  <div class="container-mm flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3" aria-label="Majang Mejeng beranda">
      <Mark size={52} class="md:!w-[60px]" />
      <span class="hidden font-serif text-xl font-semibold tracking-tight sm:inline">Majang Mejeng</span>
    </a>
    <span class="hidden h-8 w-px bg-foreground/20 xl:block" aria-hidden="true"></span>

    <nav class="hidden items-center gap-5 md:flex whitespace-nowrap" aria-label="Menu utama">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'link-fx text-sm transition',
            isActive(item.href) ? 'font-semibold' : 'text-muted-foreground hover:text-secondary',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Ganti tema terang/gelap"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-foreground/25 transition hover:border-secondary hover:text-secondary"
      >
        <svg class="h-4 w-4 dark-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
        <svg class="hidden h-4 w-4 dark-shown" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <a href="/titipkan-cerita" class="btn-primary hidden !px-5 !py-2 md:inline-flex">Mulai Brief</a>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-foreground/25 md:hidden"
        aria-label="Buka menu navigasi"
      >
        <span class="flex w-4 flex-col gap-1">
          <span class="h-0.5 w-full bg-foreground"></span>
          <span class="h-0.5 w-full bg-foreground"></span>
          <span class="h-0.5 w-full bg-foreground"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="fixed inset-0 z-50 md:hidden">
    <div class="absolute inset-0 bg-foreground/40 backdrop-blur-sm" data-menu-close></div>
    <div class="absolute inset-x-0 top-0 bg-background p-6 shadow-xl">
      <div class="flex items-center justify-between pb-4">
        <Mark size={44} />
        <button type="button" data-menu-close aria-label="Tutup menu navigasi"
          class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-foreground/20 text-lg">✕</button>
      </div>
      <nav class="flex flex-col divide-y divide-foreground/15" aria-label="Menu navigasi">
        {NAV.map((item, i) => (
          <a href={item.href} data-menu-close
            class:list={['flex items-center gap-3 py-3 text-base', isActive(item.href) ? 'font-semibold text-secondary' : 'text-foreground']}>
            <span class="zine-no font-mono text-xs">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (menu?.hasAttribute('hidden')) {
      menu.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      btn.setAttribute('aria-expanded', 'true');
    }
  });
  menu?.querySelectorAll('[data-menu-close]').forEach((el) =>
    el.addEventListener('click', () => {
      menu?.setAttribute('hidden', '');
      document.body.style.overflow = '';
      btn?.setAttribute('aria-expanded', 'false');
    })
  );
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hasAttribute('hidden')) {
      menu.setAttribute('hidden', '');
      document.body.style.overflow = '';
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('mm-theme', next); } catch {}
  });
</script>

<style>
  :global([data-theme='dark']) .dark-hidden { display: none; }
  :global(:not([data-theme='dark'])) .dark-shown { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .dark-hidden { display: none; }
    :global(html:not([data-theme='light'])) .dark-shown { display: inline; }
  }
</style>
<script>
  // Jam WIB — Asia/Jakarta eksak via Intl (bukan jam device).
  // Kedip titik dua via CSS; angka update tiap menit; pause saat tab hidden.
  (function () {
    const el = document.querySelector('[data-mm-clock]');
    if (!el) return;
    // WIB = UTC+7, dihitung manual (anti-ICU-missing), format HH:MM
    function wib() {
      const d = new Date();
      const t = new Date(d.getTime() + (7 * 60 + d.getTimezoneOffset()) * 60000);
      return String(t.getHours()).padStart(2, '0') + ':' + String(t.getMinutes()).padStart(2, '0');
    }
    let last = '';
    function tick() {
      const now = wib();
      if (now !== last) {
        last = now;
        el.textContent = now;
      }
    }
    tick();
    let iv = setInterval(tick, 1000);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { clearInterval(iv); }
      else { tick(); iv = setInterval(tick, 1000); }
    });
  })();
</script>

<style>
  /* Kedip halus titik dua jam — matikan kalau reduced-motion */
  [data-mm-clock] { position: relative; }
  @media (prefers-reduced-motion: no-preference) {
    [data-mm-clock]::after {
      content: '';
      display: inline-block;
      width: 1px;
      height: 0.9em;
      margin-left: 0.15em;
      vertical-align: -0.12em;
      background: #FF5500;
      animation: mm-blink 1s steps(1) infinite;
    }
  }
  @keyframes mm-blink {
    0%, 60% { opacity: 1; }
    61%, 100% { opacity: 0.15; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-mm-clock]::after { animation: none; opacity: 1; }
  }
</style>
