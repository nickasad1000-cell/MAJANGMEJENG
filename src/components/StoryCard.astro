---
import { Image } from 'astro:assets';
import type { Story } from '../lib/data';
import { PILLAR_LABELS } from '../lib/data';
import { resolveImage } from '../lib/images';

interface Props {
  story: Story;
  photo?: string;
  large?: boolean;
}
const { story, photo, large = false } = Astro.props;
const date = new Date(story.published_at).toLocaleDateString('id-ID', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const imgSrc = resolveImage(story.hero_image) ?? resolveImage(photo);
const alt = story.hero_image ? (story.hero_image_alt ?? story.title) : '';
---

<a
  href={`/cerita/${story.slug}`}
  class:list={[
    'group block rounded-2xl focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none',
    large && 'h-full',
  ]}
  aria-label={`Baca cerita: ${story.title}`}
>
  <article class:list={[
    'flex h-full flex-col overflow-hidden rounded-2xl border border-foreground/20 bg-card transition-transform duration-300 group-hover:-translate-y-1',
  ]}>
    <div class:list={[
      'relative w-full overflow-hidden',
      large ? 'aspect-[16/10]' : 'aspect-[16/10]',
    ]}>
      {imgSrc ? (
        <Image
          src={imgSrc}
          alt={alt}
          widths={[400, 640, 960]}
          sizes={large ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 768px) 30vw, 100vw'}
          format="webp"
          quality={78}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <>
          <div class="paper-grid absolute inset-0 opacity-40"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <p class="zine-no text-8xl" aria-hidden="true">M</p>
          </div>
        </>
      )}
    </div>
    <div class="flex flex-1 flex-col p-5">
      <p class="eyebrow mb-2 w-fit">{PILLAR_LABELS[story.pillar]}</p>
      <h3 class:list={[
        'font-serif leading-snug transition-colors group-hover:text-secondary',
        large ? 'text-2xl md:text-3xl' : 'text-xl',
      ]}>{story.title}</h3>
      {story.excerpt && (
        <p class="mt-3 line-clamp-2 text-sm text-muted-foreground">{story.excerpt}</p>
      )}
      <p class="mt-auto flex items-center justify-between pt-4 font-mono text-xs tabular-nums text-muted-foreground">
        <span>{date}</span>
        <span aria-hidden="true" class="font-bold text-secondary transition group-hover:translate-x-0.5">→</span>
      </p>
    </div>
  </article>
</a>
