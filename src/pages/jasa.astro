---
import Base from '../layouts/Base.astro';
import { getServices, getWaNumber, waLink } from '../lib/data';

const services = await getServices();
const wa = await getWaNumber();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Layanan Majang Mejeng',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.summary ?? undefined,
      provider: { '@type': 'Organization', name: 'Majang Mejeng' },
      areaServed: { '@type': 'Place', name: 'Lumajang, Jawa Timur, Indonesia' },
      ...(s.price_from != null ? { offers: { '@type': 'Offer', price: s.price_from, priceCurrency: 'IDR' } } : {}),
    },
  })),
};
---

<Base title="Jasa" description="Content production, social posting, dokumentasi, dan kampanye dari Lumajang." canonicalPath="/jasa" jsonLd={jsonLd}>
  <section class="container-mm py-14">
    <p class="eyebrow mb-2">JASA KAMI</p>
    <h1 class="font-serif text-4xl tracking-tight md:text-6xl">
      Bekerja untuk <em class="italic">cerita yang</em><br />
      <em class="italic">layak diingat</em>.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
      Dari dapur konten harian hingga dokumenter panjang. Setiap paket bisa dimulai
      dari satu percakapan singkat.
    </p>

    <ul class="mt-12 grid gap-6 md:grid-cols-2" role="list">
      {services.map((svc, idx) => (
        <li class="reveal-up">
          <article class="flex h-full flex-col rounded-2xl border border-foreground/20 bg-card p-6 transition-transform duration-300 hover:-translate-y-1">
            <p class="zine-no text-right text-5xl">№ {String(idx + 1).padStart(2, '0')}</p>
            <p class="eyebrow mb-3 w-fit">LAYANAN</p>
            <h2 class="font-serif text-2xl leading-snug">{svc.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{svc.summary}</p>
            {svc.deliverables?.length > 0 && (
              <ul class="mt-5 space-y-1.5 text-sm text-muted-foreground" role="list">
                {svc.deliverables.map((d) => (
                  <li class="flex items-start gap-2">
                    <span aria-hidden="true" class="mt-[0.55rem] inline-block h-1 w-1 shrink-0 rounded-full bg-secondary"></span>
                    {d}
                  </li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex items-center justify-between gap-3 pt-6">
              {svc.price_from != null && (
                <span class="font-mono text-xs tabular-nums text-muted-foreground">
                  Mulai Rp {svc.price_from.toLocaleString('id-ID')}
                </span>
              )}
              <a
                href={waLink(wa, `Halo Majang Mejeng, saya ingin membicarakan proyek: ${svc.title}. Konteks: brief singkat. Terima kasih.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto inline-flex items-center gap-2 rounded-full border border-secondary bg-secondary px-4 py-2 text-sm font-medium text-secondary-foreground transition hover:opacity-85"
              >
                Diskusi <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </li>
      ))}
    </ul>

    {/* Orange CTA band */}
    <div class="mt-14 overflow-hidden rounded-2xl" style="background-color: var(--surface-orange);">
      <div class="flex flex-col items-start gap-5 p-8 md:flex-row md:items-center md:justify-between md:p-10">
        <div>
          <h2 class="font-serif text-2xl leading-snug md:text-3xl">
            Tidak yakin mulai dari mana? <em class="italic">Ngobrol dulu saja.</em>
          </h2>
          <p class="mt-2 text-sm text-foreground/80">Tidak ada komitmen. Percakapan pertama selalu gratis.</p>
        </div>
        <a
          href={waLink(wa, 'Halo Majang Mejeng, saya ingin mulai ngobrol dulu.')}
          target="_blank"
          rel="noopener noreferrer"
          class="hard-shadow shrink-0 rounded-full bg-foreground px-5 py-3 text-sm font-medium text-background"
        >
          Mulai ngobrol →
        </a>
      </div>
    </div>
  </section>
</Base>
