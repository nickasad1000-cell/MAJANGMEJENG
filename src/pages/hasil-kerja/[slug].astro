---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getCases, getServices } from '../../lib/data';
import { resolveImage } from '../../lib/images';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((c) => ({ params: { slug: c.slug }, props: { case: c } }));
}

const { case: c } = Astro.props;
const services = await getServices();
const service = services.find((s) => s.id === c.service_id);
const date = new Date(c.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

const COVER_FALLBACK = '/photos/volcano-mist-aerial.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: c.title,
  description: c.summary,
  datePublished: c.published_at,
  author: { '@type': 'Organization', name: 'Majang Mejeng' },
  publisher: { '@type': 'Organization', name: 'Majang Mejeng' },
};
---

<Base title={c.title} description={c.summary} canonicalPath={`/hasil-kerja/${c.slug}`} ogType="article" ogImage={c.cover_image ?? COVER_FALLBACK}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="container-mm py-14">
    <a href="/hasil-kerja" class="link-fx inline-flex items-center gap-2 text-sm text-muted-foreground transition hover:text-secondary">
      ← Semua hasil kerja
    </a>
    <p class="eyebrow mt-8 mb-2 w-fit">STUDI KASUS / {c.client.toUpperCase()}</p>
    <h1 class="max-w-4xl font-serif text-4xl leading-tight tracking-tight md:text-6xl">{c.title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">{c.summary}</p>
    <p class="mt-3 font-mono text-xs text-muted-foreground">
      {service ? `LAYANAN: ${service.title.toUpperCase()} · ` : ''}{date}
    </p>

    <div class="mt-10 overflow-hidden rounded-2xl border border-foreground/20">
      {(resolveImage(c.cover_image) ?? resolveImage(COVER_FALLBACK)) && (
        <Image
          src={(resolveImage(c.cover_image) ?? resolveImage(COVER_FALLBACK))!}
          alt={`Proyek ${c.client}`}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 1152px, 100vw"
          format="webp"
          quality={80}
          loading="eager"
          decoding="async"
          class="aspect-video w-full object-cover"
        />
      )}
    </div>

    <section class="mt-12 max-w-3xl">
      <h2 class="font-serif text-2xl tracking-tight md:text-3xl">Hasil terukur</h2>
      {c.results?.length > 0 && (
        <ul class="mt-6 grid gap-3 sm:grid-cols-3" role="list">
          {c.results.map((r) => (
            <li class="rounded-xl border border-foreground/15 bg-card p-4 font-mono text-sm tabular-nums text-muted-foreground">
              {r}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-16 rounded-2xl p-8 text-white md:p-12" style="background:#FF5500">
      <p class="font-serif text-2xl leading-snug md:text-3xl">Mau hasil seperti ini untuk bisnismu?</p>
      <p class="mt-3 max-w-lg text-white/90">Ceritakan kebutuhanmu — kami jawab dengan rencana, bukan janji.</p>
      <a
        href={`/titipkan-cerita`}
        class="mt-6 inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-semibold transition hover:bg-white/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        style="color:#FF5500"
      >Mulai Brief →</a>
    </section>
  </article>
</Base>
