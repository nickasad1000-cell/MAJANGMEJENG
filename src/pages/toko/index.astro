---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProducts, getWaNumber, waLink, type Product } from '../../lib/data';
import { resolveImage } from '../../lib/images';

const products = await getProducts();
const wa = await getWaNumber();

const CATEGORIES = [
  { value: 'all', label: 'Semua' },
  { value: 'merchandise', label: 'Merchandise' },
  { value: 'print', label: 'Print' },
  { value: 'bundle', label: 'Bundle' },
];
const { cat } = Astro.url.searchParams;
const activeCat = CATEGORIES.some((c) => c.value === cat) ? cat! : 'all';
const filtered = activeCat === 'all' ? products : products.filter((p) => p.category === activeCat);

const PHOTOS = [
  '/photos/rice-terraces.jpg', '/photos/semeru-sunrise.jpg', '/photos/boat-sunrise.jpg',
  '/photos/forest-path-fog.jpg', '/photos/horse-bromo.jpg', '/photos/volcano-mist-aerial.jpg',
];

const chip = (active: boolean) =>
  `rounded-full border px-4 py-1.5 text-sm transition ${
    active
      ? 'border-transparent bg-foreground font-semibold text-background'
      : 'border-foreground/30 text-muted-foreground hover:border-secondary hover:text-secondary'
  }`;

const orderMsg = (p: Product) =>
  waLink(wa, `Halo Majang Mejeng, saya ingin pesan:\n1. ${p.title} — Rp ${p.price_idr.toLocaleString('id-ID')} (${p.slug})\n\nMohon info ongkir & cara bayar. Terima kasih.`);
---

<Base title="Toko" description="Benda kecil dari Lumajang — sablon manual, zine, dan bundle kolaborasi." canonicalPath="/toko">
  <section class="container-mm py-14">
    <p class="eyebrow mb-2">TOKO</p>
    <h1 class="font-serif text-4xl tracking-tight md:text-6xl">
      Benda kecil <em class="italic">dari Lumajang</em>.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
      Sablon manual, zine, dan bundle kolaborasi dari para tetangga. Pesan via
      WhatsApp — ongkir &amp; pembayaran kami atur setelahnya.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-2" role="group" aria-label="Filter kategori produk">
      {CATEGORIES.map((c) => (
        <a
          href={c.value === 'all' ? '/toko' : `/toko?cat=${c.value}`}
          class={chip(activeCat === c.value)}
          aria-current={activeCat === c.value ? 'true' : undefined}
        >
          {c.label}
        </a>
      ))}
      <p class="ml-auto font-mono text-xs tabular-nums text-muted-foreground" role="status">{filtered.length} produk</p>
    </div>

    {filtered.length === 0 ? (
      <div class="mt-14 rounded-2xl border border-dashed border-foreground/30 p-12 text-center">
        <p class="font-serif text-2xl tracking-wide">BELUM ADA PRODUK</p>
        <p class="mt-2 text-sm text-muted-foreground">Produk untuk kategori ini akan tampil di sini.</p>
      </div>
    ) : (
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {filtered.map((p, idx) => (
          <div class="reveal-up">
            <a
              href={`/toko/${p.slug}`}
              class="group block h-full rounded-2xl focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
              aria-label={`Lihat ${p.title}`}
            >
              <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-foreground/20 bg-card transition-transform duration-300 hover:-translate-y-1">
                <div class="aspect-square w-full overflow-hidden bg-surface-cream">
                  {resolveImage(p.cover_image) ? (
                    <Image
                      src={resolveImage(p.cover_image)!}
                      alt={p.title}
                      widths={[400, 640]}
                      sizes="(min-width: 1024px) 29vw, (min-width: 768px) 45vw, 100vw"
                      format="webp"
                      quality={78}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <Image
                      src={resolveImage(PHOTOS[idx % PHOTOS.length])!}
                      alt=""
                      widths={[400, 640]}
                      sizes="(min-width: 1024px) 29vw, (min-width: 768px) 45vw, 100vw"
                      format="webp"
                      quality={78}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  )}
                </div>
                <div class="flex flex-1 flex-col p-4">
                  <p class="eyebrow mb-1 self-start !text-[0.6rem] !px-2.5 !py-1">{p.category.toUpperCase()}</p>
                  <h2 class="font-serif text-lg leading-tight">{p.title}</h2>
                  <div class="mt-auto flex items-center justify-between gap-3 pt-3">
                    <span class="font-mono text-sm tabular-nums text-foreground">
                      Rp {p.price_idr.toLocaleString('id-ID')}
                    </span>
                    <button
                      type="button"
                      data-wa={waLink(wa, orderMsg(p))}
                      class="inline-flex shrink-0 cursor-pointer items-center rounded-full bg-[#FF5500] px-3.5 py-1.5 text-xs font-semibold text-white transition hover:opacity-90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
                      aria-label={`Pesan ${p.title} via WhatsApp`}
                    >Pesan</button>
                  </div>
                </div>
              </article>
            </a>
          </div>
        ))}
      </div>
    )}
  </section>
  <script>
    document.querySelectorAll('button[data-wa]').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.open(btn.getAttribute('data-wa'), '_blank', 'noopener');
      });
    });
  </script>
</Base>
