---
import Base from '../layouts/Base.astro';
import { getCases } from '../lib/data';

const cases = await getCases();

const PHOTOS = ['/photos/boat-sunrise.jpg', '/photos/fishermen-nets.jpg', '/photos/tangkuban-woman.jpg'];
---

<Base title="Hasil Kerja" description="Studi kasus kampanye dan dokumentasi yang pernah dikerjakan Majang Mejeng." canonicalPath="/hasil-kerja">
  <section class="container-mm py-14">
    <p class="eyebrow mb-2">HASIL KERJA</p>
    <h1 class="font-serif text-4xl tracking-tight md:text-6xl">
      Bukti, bukan <em class="italic">janji</em>.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
      Kampanye, dokumentasi, dan konten yang sudah jalan — beserta hasil nyatanya.
    </p>

    {cases.length === 0 ? (
      <div class="mt-14 rounded-2xl border border-dashed border-foreground/30 p-12 text-center">
        <p class="font-serif text-2xl">Belum ada studi kasus.</p>
        <p class="mt-2 text-sm text-muted-foreground">Hasil kerja pertama akan tampil di sini.</p>
      </div>
    ) : (
      <div class="mt-12 space-y-8">
        {cases.map((c, idx) => (
          <a href={`/hasil-kerja/${c.slug}`} class="reveal-up block focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none" aria-label={`Baca studi kasus ${c.client}`}>
          <article class="overflow-hidden rounded-2xl border border-foreground/20 bg-card transition-transform duration-300 hover:-translate-y-1 md:grid md:grid-cols-12">
            <div class="relative min-h-[180px] bg-accent/40 md:col-span-4">
              {c.cover_image ? (
                <img src={c.cover_image} alt={`Proyek ${c.client}`} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
              ) : (
                <img src={PHOTOS[idx % PHOTOS.length]} alt="" width={800} height={600} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover opacity-90" />
              )}
            </div>
            <div class="flex flex-col p-6 md:col-span-8 md:p-8">
              <p class="eyebrow mb-2">STUDI KASUS / {c.client.toUpperCase()}</p>
              <h2 class="font-serif text-2xl leading-snug md:text-3xl">{c.title}</h2>
              <p class="mt-3 leading-relaxed text-muted-foreground">{c.summary}</p>
              {c.results?.length > 0 && (
                <ul class="mt-5 grid gap-2 sm:grid-cols-3" role="list">
                  {c.results.map((r) => (
                    <li class="rounded-xl border border-foreground/15 p-3 font-mono text-xs tabular-nums text-muted-foreground">
                      {r}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
          </a>
        ))}
      </div>
    )}
  </section>
</Base>
